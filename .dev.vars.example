# Local development secrets. `pnpm run configure dev` writes .dev.vars for you,
# or copy this file to .dev.vars and fill it in. Never commit .dev.vars.

# 32 random bytes, base64. Generate with:
#   node -e "console.log(crypto.getRandomValues(Buffer.alloc(32)).toString('base64'))"
LEDGER_KEY=

# Only used when Turnstile is on in wishlist.config.json. This is Cloudflare's
# always-pass test secret; the dev server uses the matching test site key.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Create a separate OAuth app for local dev with callback
#   http://localhost:3000/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional. Callback: http://localhost:3000/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
