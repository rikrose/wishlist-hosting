{
  "name": "wishlist-holder",
  "version": "0.1.0",
  "private": true,
  "description": "A self-hosted wishlist for Cloudflare Workers + D1, with secret purchase tracking and group gifts.",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "pnpm run db:migrate:local && vp dev --port 3000",
    "build": "vp build",
    "preview": "vp build && vp preview",
    "deploy": "pnpm run db:migrate:remote && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "configure": "node scripts/configure.ts",
    "screenshots": "node scripts/screenshots.ts",
    "cf-typegen": "wrangler types",
    "check": "vp check",
    "test": "vp test"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "arctic": "^3.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.3.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.26.0",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "playwright-core": "^1.65.0",
    "typescript": "^6.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "^4.70.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@12.18.0"
}
